{
  "name": "mastra-voice-gandr",
  "version": "0.1.3",
  "description": "Gandr text-to-speech voice for Mastra agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
