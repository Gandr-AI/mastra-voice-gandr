  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gandr-AI/mastra-voice-gandr"
  },
  "peerDependencies": {
    "@mastra/core": ">=0.13.0"
  },
  "devDependencies": {
    "@mastra/core": "^0.13.0",
    "typescript": "^5.5.0"
  }
}
